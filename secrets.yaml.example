# Example secrets configuration for ESP32 JKBMS Growatt Bridge
# Copy this file to secrets.yaml and adjust with your own credentials

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
ap_password: "YOUR_FALLBACK_AP_PASSWORD"
ota_password: "YOUR_OTA_PASSWORD"

# MQTT Broker Settings
mqtt_broker: "192.168.1.100"
mqtt_username: "your_mqtt_user"
mqtt_password: "your_mqtt_password"

# JK-BMS Bluetooth MAC Address (e.g. C8:47:80:XX:XX:XX)
jkbms_mac_address: "AA:BB:CC:DD:EE:FF"
